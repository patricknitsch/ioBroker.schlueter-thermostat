{
	"$schema": "https://raw.githubusercontent.com/ioBroker/web-components/main/schemas/manifest.json",
	"manifestVersion": 1,
	"tag": "iob-schlueter-thermostat-card",
	"name": { "en": "Thermostat", "de": "Thermostat" },
	"description": {
		"en": "Schlüter DITRA-HEAT thermostat: temperatures, status and controls, like the Device Manager card",
		"de": "Schlüter DITRA-HEAT Thermostat: Temperaturen, Status und Steuerung wie in der Device-Manager-Karte"
	},
	"icon": "thermostat-card.svg",
	"module": "thermostat-card.js",
	"size": { "width": 360, "height": 400 },
	"settings": {
		"type": "panel",
		"items": {
			"instance": {
				"type": "instance",
				"adapter": "schlueter-thermostat",
				"label": { "en": "Instance", "de": "Instanz" }
			},
			"thermostat": {
				"type": "selectSendTo",
				"command": "getThermostats",
				"instance": "${data.instance}",
				"alsoDependsOn": ["instance"],
				"label": { "en": "Thermostat", "de": "Thermostat" },
				"help": {
					"en": "Empty: the first thermostat of the instance",
					"de": "Leer: das erste Thermostat der Instanz"
				}
			}
		}
	}
}
